# EditorConfig — keeps every contributor's IDE in sync with the
# project's whitespace rules. https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Markdown can use trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
