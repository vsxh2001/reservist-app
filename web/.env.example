VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Set to 1 to enable the legacy member-picker fallback alongside Google sign-in.
# Useful for demos that don't want to open a Google OAuth popup.
# VITE_MOCK_AUTH=1

# Web Push VAPID public key — safe to ship, generate with:
#   node -e 'const w=require("web-push"); console.log(JSON.stringify(w.generateVAPIDKeys()))'
# Put the private key in supabase/.env as VAPID_PRIVATE_KEY
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ── Integration test secrets (not shipped to client) ──────────────────────────
# JWT secret used by the local Supabase stack to verify tokens.
# Defaults to the standard local-dev value when not set.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Service-role key for test fixture setup (bypasses all RLS).
# Defaults to the local-dev static key when not set.
# NEVER expose this in production or commit real keys.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
