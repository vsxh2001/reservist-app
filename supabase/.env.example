# Supabase + Edge Function secrets.
#
# Local dev: copy to `supabase/.env` (gitignored). The Supabase CLI picks
# these up automatically when running `supabase start`.
#
# Hosted Supabase: do NOT copy this file to the cloud project. Set each
# secret via the dashboard (Project Settings → Edge Functions → Secrets)
# or via the CLI:
#
#   supabase secrets set VAPID_PRIVATE_KEY=... --project-ref YOUR_REF
#   supabase secrets set VAPID_PUBLIC_KEY=...
#   supabase secrets set VAPID_SUBJECT='mailto:you@example.com'
#   supabase secrets set SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=...
#   supabase secrets set SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=...
#   supabase secrets set CORS_ALLOWED_ORIGINS=https://your.app
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected at
# runtime by the Edge Function platform; you do not set those manually.

# --- Google OAuth (used by GoTrue for the Sign in with Google flow) ---
# Create an OAuth 2.0 Web client in GCP Console → APIs & Services →
# Credentials. Redirect URI must be:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# Authorized origins: your Vercel domain.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-secret

# --- Web Push VAPID keys ---
# Generate once with `npx web-push generate-vapid-keys`.
# The PUBLIC key also goes into web/.env.production as VITE_VAPID_PUBLIC_KEY.
# The PRIVATE key NEVER leaves the Edge Function environment.
# VAPID_SUBJECT must be a mailto: or https: URL the browser can resolve.
VAPID_PUBLIC_KEY=BHe_REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:contact@yourdomain.example

# --- CORS allowlist for send-push Edge Function (PR #128) ---
# Comma-separated origin list. When set, the function only echoes one of
# these in Access-Control-Allow-Origin (Vary: Origin so caches partition).
# When unset, falls back to "*" (backward-compatible).
# Example:
#   CORS_ALLOWED_ORIGINS=https://reservist.example,https://reservist-staging.vercel.app
CORS_ALLOWED_ORIGINS=

# --- send-push rate limit (PR #130) ---
# Maximum push invocations per caller per 60-second sliding window.
# Default (when unset): 30. A commander rarely fires more than ~5/min
# in legit use. Set higher only if you've seen a 429 in production
# logs from an honest workflow.
SEND_PUSH_RATE_MAX=
