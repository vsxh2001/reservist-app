# Production env template for the web/PWA build.
#
# Copy this to .env.production and fill in the values from your hosted
# Supabase project before running `npm run build`. Never commit a real
# .env.production — it's gitignored alongside other .env files.
#
# Notes vs .env.example (local dev):
#   - Use https URLs, not http://127.0.0.1.
#   - Use the anon key from your hosted project, not the local-dev key.
#   - Do not put SUPABASE_SERVICE_ROLE_KEY here. The browser never needs
#     it. Service-role keys belong in the Edge Function runtime
#     environment (set via the Supabase dashboard), not in client builds.
#   - VITE_MOCK_AUTH must be unset in production.

# Hosted Supabase project URL, e.g. https://abcdefghij.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key from your hosted Supabase project's API settings.
VITE_SUPABASE_ANON_KEY=your_production_anon_key_here

# Web Push VAPID public key. Same value as supabase/.env's
# VAPID_PUBLIC_KEY — the private half lives only on the Edge Function
# runtime. If push notifications are not enabled, leave this empty and
# the Notifications card will surface a "not configured" hint.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
